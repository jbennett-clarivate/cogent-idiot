{
  "name": "cogent-idiot",
  "version": "1.0.0",
  "description": "Angular v20 application with Node.js backend - migrated from legacy HTML/JS",
  "main": "server.js",
  "scripts": {
    "ng": "ng",
    "start": "node server.js",
    "build:dev": "ng build --configuration development --output-path=public_html",
    "watch": "ng build --watch --configuration development --output-path=public_html",
    "test": "ng test",
    "server": "node --no-deprecation server.js",
    "dev": "concurrently \"node --no-deprecation server.js\" \"ng serve\"",
    "build:prod": "ng build --configuration production --output-path=public_html",
    "test:ci": "ng test --watch=false",
    "test:flatpak": "FIREFOX_BIN=./scripts/firefox-flatpak.sh ng test --watch=false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/animations": "20.3.25",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.25",
    "@angular/compiler": "20.3.25",
    "@angular/core": "20.3.25",
    "@angular/forms": "20.3.25",
    "@angular/platform-browser": "20.3.25",
    "@angular/platform-browser-dynamic": "20.3.25",
    "@angular/router": "20.3.25",
    "cors": "2.8.5",
    "dotenv": "17.2.1",
    "express": "4.22.2",
    "express-session": "1.18.2",
    "helmet": "8.1.0",
    "mysql2": "3.14.3",
    "rxjs": "7.8.0",
    "session-file-store": "1.5.0",
    "three": "^0.180.0",
    "tslib": "2.3.0",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.30",
    "@angular/cli": "20.3.30",
    "@angular/compiler-cli": "20.3.25",
    "@eslint/js": "^9.39.5",
    "@types/express-session": "1.18.2",
    "@types/jasmine": "5.1.0",
    "@types/node": "18.19.122",
    "@types/three": "^0.180.0",
    "@webgpu/types": "0.1.72",
    "angular-eslint": "^20.7.0",
    "concurrently": "7.6.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jasmine-core": "5.1.0",
    "karma": "6.4.0",
    "karma-coverage": "2.2.0",
    "karma-firefox-launcher": "2.1.3",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.71.0"
  },
  "private": true
}
